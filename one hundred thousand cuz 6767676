				path:find("HDAdminClient") or 
				remote.Name == "__FUNCTION" then 
				continue 
			end

			local code = generateName(math.random(15, 25))
			remotes[code] = remote

			-- Intento de ejecución
			self:RunRemote(remote, "local a=Instance.new('Model', workspace) a.Name='"..code.."'")
		end
	end

	-- Bucle de 100 intentos
	for i = 1, 100 do
		for code, rem in pairs(remotes) do
			if workspace:FindFirstChild(code) then
				local found = rem
				pcall(function() workspace[code]:Destroy() end)
				return found, os.clock() - timee
			end
		end
		task.wait(0.1)
	end

	return nil
end

return Scanner
